{
  "name": "power-focusable",
  "version": "4.3.4",
  "description": "High-precision focus management utility with full composed tree support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "focus",
    "focus-management",
    "focusable",
    "shadow-dom",
    "shadowdom",
    "typescript",
    "utility"
  ],
  "author": "Yusuke Kamiyamane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y14e/power-focusable.git"
  },
  "bugs": {
    "url": "https://github.com/y14e/power-focusable/issues"
  },
  "homepage": "https://github.com/y14e/power-focusable#readme",
  "devDependencies": {
    "bun-types": "latest",
    "happy-dom": "^20.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@emnapi/wasi-threads": "1.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
